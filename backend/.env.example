# ==============================================================================
# Variables de entorno del backend (inventory-service) — PLANTILLA
# ------------------------------------------------------------------------------
# COMO USARLO:
#   1. Copia este archivo como .env      ->   cp .env.example .env
#   2. Reemplaza los valores de ejemplo por los reales.
#   3. El archivo .env NO se sube al repositorio (esta en .gitignore).
#      Este .env.example SI se sube: sirve de guia para quien clone el proyecto.
#
# COMO SE LEEN:
#   - En local / IDE: las carga spring-dotenv desde este directorio (junto al pom.xml).
#   - En Docker / produccion: las inyecta el contenedor o el servidor.
#   El application.yml las consume con la sintaxis ${VARIABLE:valor-por-defecto}.
# ==============================================================================

# --- Base de datos (PostgreSQL) ----------------------------------------------
# Opcionales en local: si no las defines, el backend usa estos mismos valores.
DB_URL=jdbc:postgresql://localhost:5432/inventory
DB_USERNAME=inventory
DB_PASSWORD=inventory

# --- Seguridad (JWT) ---------------------------------------------------------
# Clave para firmar los tokens (algoritmo HS256). MINIMO 32 caracteres.
# Genera una propia y NUNCA uses esta de ejemplo en produccion.
# Puedes generar una con:  openssl rand -hex 32
JWT_SECRET=reemplaza-por-una-clave-aleatoria-de-minimo-32-caracteres
# Vigencia del token en milisegundos (opcional). Por defecto 3600000 = 1 hora.
JWT_EXPIRATION_MS=3600000

# --- CORS --------------------------------------------------------------------
# Origenes del frontend permitidos, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:9000,http://localhost:8080

# --- Correo (SMTP) — para enviar el inventario en PDF ------------------------
# Recomendado para pruebas: Mailtrap (sandbox; los correos no salen a bandejas
# reales). Toma estos datos de: Mailtrap -> Email Testing -> tu Inbox -> SMTP Settings.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=tu-usuario-de-mailtrap
MAIL_PASSWORD=tu-clave-de-mailtrap
MAIL_FROM=tu-usuario-de-mailtrap

# Alternativa con Gmail (envio real): requiere una "App Password" (no la clave normal).
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=tucorreo@gmail.com
#   MAIL_PASSWORD=tu-app-password-de-16-caracteres
#   MAIL_FROM=tucorreo@gmail.com    # con Gmail debe ser la MISMA cuenta que autentica
