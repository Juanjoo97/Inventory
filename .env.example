# Copia este archivo como .env y ajusta los valores
JWT_SECRET=cambia-esta-clave-secreta-de-al-menos-32-bytes-para-hs256-2024
CORS_ALLOWED_ORIGINS=http://localhost:9000,http://localhost:8080

# SMTP (para el envio del PDF por correo). Ejemplo con Gmail App Password o Mailtrap.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=tu-app-password
MAIL_FROM=no-reply@litethinking.com
